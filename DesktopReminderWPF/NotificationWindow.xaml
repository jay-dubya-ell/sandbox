<Window x:Class="DesktopReminder.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Manual">
    <Border Background="#1f1f1f" BorderBrush="#3a8ee6" BorderThickness="2" CornerRadius="6">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Foreground="#DDDDDD"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       TextWrapping="Wrap"/>

            <Button x:Name="AcknowledgeButton"
                    Grid.Row="2"
                    Content="Acknowledge"
                    Click="Acknowledge_Click"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    Padding="12,5"
                    Background="#3a8ee6"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>
    </Border>
</Window>
