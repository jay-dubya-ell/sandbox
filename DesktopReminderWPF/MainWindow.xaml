<Window x:Class="DesktopReminder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Reminder — Settings"
        Height="620" Width="440"
        MinHeight="620" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: enable/disable -->
        <Border Grid.Row="0" Background="#F2F2F2" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkEnabled" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                          Content="Notifications enabled"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="General" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Title" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtTitle" Margin="0,0,0,8"/>

                        <TextBlock Text="Message" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtMessage" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Schedule" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Repeat every (minutes)" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtInterval" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                        <TextBlock Text="Active days" Margin="0,0,0,4"/>
                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox x:Name="ChkMon" Content="Mon" Margin="0,0,10,4"/>
                            <CheckBox x:Name="ChkTue" Content="Tue" Margin="0,0,10,4"/>
                            <CheckBox x:Name="ChkWed" Content="Wed" Margin="0,0,10,4"/>
                            <CheckBox x:Name="ChkThu" Content="Thu" Margin="0,0,10,4"/>
                            <CheckBox x:Name="ChkFri" Content="Fri" Margin="0,0,10,4"/>
                            <CheckBox x:Name="ChkSat" Content="Sat" Margin="0,0,10,4"/>
                            <CheckBox x:Name="ChkSun" Content="Sun" Margin="0,0,10,4"/>
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Start time (HH:mm)" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtStartTime"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="End time (HH:mm)" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtEndTime"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Appearance and position" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Screen position" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbPosition" Margin="0,0,0,8"
                                  SelectionChanged="CmbPosition_SelectionChanged">
                            <ComboBoxItem Content="Top left" Tag="TopLeft"/>
                            <ComboBoxItem Content="Top right" Tag="TopRight"/>
                            <ComboBoxItem Content="Bottom left" Tag="BottomLeft"/>
                            <ComboBoxItem Content="Bottom right" Tag="BottomRight"/>
                            <ComboBoxItem Content="Center" Tag="Center"/>
                            <ComboBoxItem Content="Custom position (X/Y below)" Tag="Custom"/>
                        </ComboBox>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Custom X" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtCustomX"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Custom Y" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtCustomY"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Width" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtWidth"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Height" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtHeight"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Advanced" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Clock check interval (seconds)" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtCheckInterval" Width="80" HorizontalAlignment="Left"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer: actions -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#666666" FontSize="12"/>

            <Button x:Name="BtnTest" Grid.Column="1" Content="Test notification"
                    Padding="12,6" Margin="0,0,8,0" Click="BtnTest_Click"/>
            <Button x:Name="BtnApply" Grid.Column="2" Content="Apply"
                    Padding="18,6" Margin="0,0,8,0" Background="#3a8ee6" Foreground="White"
                    BorderThickness="0" Click="BtnApply_Click"/>
            <Button x:Name="BtnExit" Grid.Column="3" Content="Exit"
                    Padding="12,6" Click="BtnExit_Click"/>
        </Grid>
    </Grid>
</Window>
